    {
      "parameters": {
        "jsCode": "// Filter: keep only valid ytIds, exclude duplicates\nconst results = $input.first().json.results || [];\nconst knownIds = ($('Webhook').first().json.body?.exclude_ids || '').split(',').filter(Boolean);\nconst filtered = results.filter(r => r.ytId && !knownIds.includes(r.ytId));\nconsole.log(`Found ${results.length} results, ${filtered.length} after filter`);\nreturn filtered.map(r => ({ json: r }));"
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000003",
      "name": "Filter Results",
      "type": "n8n-nodes-base.code",
