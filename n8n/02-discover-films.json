{
  "name": "QA — Découverte Films Turcs",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "qa-discover-films",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://qisas-asturiya.vercel.app/api/n8n?action=search-films",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{$env.N8N_SECRET}}" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "query", "value": "={{ $json.body.query }}" },
            { "name": "max",   "value": "={{ $json.body.max || 20 }}" },
            { "name": "duration_filter", "value": "={{ $json.body.duration_filter || 'long' }}" }
          ]
        },
        "options": { "timeout": 30000 }
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000002",
      "name": "Search YouTube",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "// Filter results: exclude already-known IDs if provided\nconst results = $input.first().json.results || [];\nconst knownIds = ($input.first().json.body?.exclude_ids || '').split(',').filter(Boolean);\n\nconst filtered = results.filter(r => r.ytId && !knownIds.includes(r.ytId));\n\nreturn filtered.map(r => ({ json: r }));"
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000003",
      "name": "Filter Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://qisas-asturiya.vercel.app/api/n8n?action=import-films",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{$env.N8N_SECRET}}" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": {
          "ytIds": "={{ $items().map(i => i.json.ytId) }}",
          "category": "={{ $('Webhook').first().json.body.category || 'دراما' }}",
          "lang": "={{ $('Webhook').first().json.body.lang || 'ar' }}"
        },
        "options": { "timeout": 60000 }
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000004",
      "name": "Import Films to Library",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000005",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1120, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "Search YouTube", "type": "main", "index": 0 }]]
    },
    "Search YouTube": {
      "main": [[{ "node": "Filter Results", "type": "main", "index": 0 }]]
    },
    "Filter Results": {
      "main": [[{ "node": "Import Films to Library", "type": "main", "index": 0 }]]
    },
    "Import Films to Library": {
      "main": [[{ "node": "Respond", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "versionId": "b2c3d4e5-0002-0002-0002-000000000000",
  "_comment": {
    "usage": "POST /webhook/qa-discover-films",
    "body_examples": [
      {
        "query": "فيلم تركي مدبلج عربي دراما 2024",
        "category": "دراما",
        "lang": "ar",
        "max": 20
      },
      {
        "query": "فيلم تركي مدبلج عربي رعب إثارة",
        "category": "رعب",
        "lang": "ar",
        "max": 20
      },
      {
        "query": "Turkish movie dubbed Arabic action 2023 2024",
        "category": "أكشن",
        "lang": "ar",
        "max": 20
      }
    ],
    "categories": ["دراما", "أكشن", "رعب", "رومانسية", "كوميديا", "تاريخي", "إثارة"]
  }
}
